{
  "name": "taxverse-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Smart contract TaxVerse (Solidity + Hardhat 3)",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat ignition deploy ignition/modules/TaxVerse.ts --network localhost",
    "seed:local": "hardhat run scripts/seed-local.ts --network localhost",
    "deploy:sepolia": "hardhat ignition deploy ignition/modules/TaxVerse.ts --network sepolia --verify"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^26.6.4",
    "hardhat": "^3.18.1",
    "typescript": "~5.9",
    "viem": "^2.57.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
